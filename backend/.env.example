# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@db.supabase.co:5432/postgres

# ── Supabase ──────────────────────────────────────────────────────
# ── Redis (Upstash) ───────────────────────────────────────────────
UPSTASH_REDIS_URL=rediss://your-upstash-url
UPSTASH_REDIS_TOKEN=your-upstash-token

# ── AI Keys ───────────────────────────────────────────────────────
# Free tier — rotate these (get from Google Cloud Console)
GEMINI_KEY_1=AIza...
GEMINI_KEY_2=AIza...
GEMINI_KEY_3=AIza...
GEMINI_KEY_4=AIza...
GEMINI_KEY_5=AIza...

# Premium tier
ANTHROPIC_API_KEY=sk-ant-...

# Optional — reserved for future YarnGPT TTS integration
YARNGPT_API_KEY=

# ── Stripe ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# These MUST match the frontend's VITE_STRIPE_* price IDs.
# NOTE: use Stripe *price* IDs (price_...), NOT product IDs (prod_...).
STRIPE_THINKER_LITE_PRICE_ID=price_...   # Thinker Lite ($4/mo) -> "lite" plan
STRIPE_DEEP_THINKER_PRICE_ID=price_...   # Deep Thinker ($8/mo) -> "premium" plan
# Annual prices. Leave blank until they exist in Stripe -- the frontend hides
# the monthly/annual toggle unless BOTH annual price IDs are configured.
STRIPE_THINKER_LITE_ANNUAL_PRICE_ID=
STRIPE_DEEP_THINKER_ANNUAL_PRICE_ID=
# Deprecated aliases (optional) — kept for backward compatibility, both map to premium.
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PREMIUM_ANNUAL_PRICE_ID=

# ── App ───────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=your-secret-key-min-32-chars
# In production: FRONTEND_URL=https://usesynapse.cv
FRONTEND_URL=http://localhost:5173

# ── Support email (Resend) ───────────────────────────────────────
# Where tickets are delivered. Must match the frontend VITE_SUPPORT_EMAIL.
SUPPORT_EMAIL=help@support.usesynapse.cv
# Leave blank to disable sending — tickets are still saved, just not emailed.
RESEND_API_KEY=
# Must be on a domain verified in Resend, or sends are rejected.
MAIL_FROM=Synapse Support <help@support.usesynapse.cv>
# Include the production dashboard origin(s) in production, e.g.:
# ALLOWED_ORIGINS=https://usesynapse.cv,https://www.usesynapse.cv
ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_ORIGIN_REGEX=chrome-extension://.*

# ── Rate Limits ───────────────────────────────────────────────────
FREE_DAILY_LIMIT=100
FREE_LIFETIME_LIMIT=500
LITE_MONTHLY_LIMIT=300

# ── First-party auth ─────────────────────────────────────────────
# APP_SECRET_KEY (below) signs access tokens. It must be >=32 chars or the app
# refuses to boot. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# Google OAuth. GOOGLE_REDIRECT_URI must match the Cloud Console entry
# byte-for-byte, including scheme, host and path. Register both the localhost
# and production values there.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# How many proxies sit in front of the app. 0 for local development. Behind
# Render or any CDN this must be set, or every user shares one rate-limit
# bucket and the login limiter locks out the world.
TRUSTED_PROXY_COUNT=0

# Migrations only. Set this when DATABASE_URL points at a transaction-mode
# pooler, since DDL and advisory locks need a direct connection. Blank falls
# back to DATABASE_URL.
MIGRATION_DATABASE_URL=
