# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@db.supabase.co:5432/postgres

# ── Supabase ──────────────────────────────────────────────────────
# ── Redis (Upstash) ───────────────────────────────────────────────
UPSTASH_REDIS_URL=rediss://your-upstash-url
UPSTASH_REDIS_TOKEN=your-upstash-token

# ── AI Keys ───────────────────────────────────────────────────────
# Free tier — rotate these (get from Google Cloud Console)
GEMINI_KEY_1=AIza...
GEMINI_KEY_2=AIza...
GEMINI_KEY_3=AIza...
GEMINI_KEY_4=AIza...
GEMINI_KEY_5=AIza...

# Premium tier
ANTHROPIC_API_KEY=sk-ant-...

# Optional — reserved for future YarnGPT TTS integration
YARNGPT_API_KEY=

# ── Paystack ──────────────────────────────────────────────────────
# Webhooks are verified with this same secret key. Point the dashboard's
# webhook URL at https://api.usesynapse.cv/api/v1/webhooks/paystack.
PAYSTACK_SECRET_KEY=sk_live_...
# Every plan must be priced in this currency.
PAYSTACK_CURRENCY=NGN
# These MUST match the frontend's VITE_PAYSTACK_* plan codes (PLN_...).
PAYSTACK_THINKER_LITE_PLAN_CODE=PLN_...   # Thinker Lite (N5,500/mo) -> "lite" plan
PAYSTACK_DEEP_THINKER_PLAN_CODE=PLN_...   # Deep Thinker (N11,000/mo) -> "premium" plan
# Annual plans. Leave blank until they exist in Paystack -- the frontend hides
# the monthly/annual toggle unless BOTH annual plan codes are configured.
PAYSTACK_THINKER_LITE_ANNUAL_PLAN_CODE=
PAYSTACK_DEEP_THINKER_ANNUAL_PLAN_CODE=
# Free trial: checkout charges PAYSTACK_CARD_CHECK_AMOUNT (kobo, so 5000 =
# N50) to save the card, refunds it, and first bills TRIAL_DAYS later.
PAYSTACK_CARD_CHECK_AMOUNT=5000
TRIAL_DAYS=7

# ── App ───────────────────────────────────────────────────────────
APP_ENV=development
# Required: generate a unique secret before starting the backend.
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=replace-me-with-a-generated-secret
# FRONTEND_URL, ALLOWED_ORIGINS and GOOGLE_REDIRECT_URI default by APP_ENV:
# localhost:5173 / localhost:8000 in development, usesynapse.cv /
# api.usesynapse.cv otherwise (URLS in app/core/config.py). Set them only to
# override, e.g. after moving hosts.
# FRONTEND_URL=http://localhost:5173

# ── Support email (Resend) ───────────────────────────────────────
# Where tickets are delivered. Must match the frontend VITE_SUPPORT_EMAIL.
SUPPORT_EMAIL=help@support.usesynapse.cv
# Leave blank to disable sending — tickets are still saved, just not emailed.
RESEND_API_KEY=
# Must be on a domain verified in Resend, or sends are rejected.
MAIL_FROM=Synapse Support <help@support.usesynapse.cv>
# Blank means FRONTEND_URL (plus its www. host in production).
# ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_ORIGIN_REGEX=chrome-extension://.*

# ── Rate Limits ───────────────────────────────────────────────────
FREE_DAILY_LIMIT=100
FREE_LIFETIME_LIMIT=500
LITE_MONTHLY_LIMIT=300

# ── First-party auth ─────────────────────────────────────────────
# APP_SECRET_KEY (below) signs access tokens. It must be >=32 chars or the app
# refuses to boot. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# Google OAuth. GOOGLE_REDIRECT_URI must match the Cloud Console entry
# byte-for-byte, including scheme, host and path. Register both the localhost
# and production values there.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# How many proxies sit in front of the app. 0 for local development. Behind
# Render or any CDN this must be set, or every user shares one rate-limit
# bucket and the login limiter locks out the world.
TRUSTED_PROXY_COUNT=0

# Migrations only. Set this when DATABASE_URL points at a transaction-mode
# pooler, since DDL and advisory locks need a direct connection. Blank falls
# back to DATABASE_URL.
MIGRATION_DATABASE_URL=
