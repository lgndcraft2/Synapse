# Where the API lives. With Supabase gone this is the one setting that
# breaks everything if it is wrong, so ConfigBanner warns when it is unset.
VITE_BACKEND_URL=http://localhost:8000

# ── Support ───────────────────────────────────────────────────────
# Shown on /support and used for the mailto: fallback. Must match the
# backend's SUPPORT_EMAIL.
VITE_SUPPORT_EMAIL=help@support.usesynapse.cv
VITE_STRIPE_THINKER_LITE_PRICE_ID=price_...
VITE_STRIPE_DEEP_THINKER_PRICE_ID=price_...
# Annual price IDs (must match the backend). Leave blank to hide the
# monthly/annual toggle on /billing and bill everyone monthly.
VITE_STRIPE_THINKER_LITE_ANNUAL_PRICE_ID=
VITE_STRIPE_DEEP_THINKER_ANNUAL_PRICE_ID=
# Chrome extension ID — enables the dashboard→extension session handoff.
# Find it at chrome://extensions (Developer mode). Leave blank to disable handoff.
VITE_EXTENSION_ID=
