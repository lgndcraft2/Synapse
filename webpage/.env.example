# Where the API lives. Leave unset: `npm run dev` uses http://localhost:8000
# and a production build uses https://api.usesynapse.cv (src/lib/config.ts).
# Set it only to point at a different backend, e.g. staging.
# VITE_BACKEND_URL=

# ── Support ───────────────────────────────────────────────────────
# Shown on /support and used for the mailto: fallback. Must match the
# backend's SUPPORT_EMAIL.
VITE_SUPPORT_EMAIL=help@support.usesynapse.cv
# ── Paystack plans ────────────────────────────────────────────────
# Plan codes (PLN_...). Must match the backend's PAYSTACK_* plan codes.
VITE_PAYSTACK_THINKER_LITE_PLAN_CODE=PLN_...
VITE_PAYSTACK_DEEP_THINKER_PLAN_CODE=PLN_...
# Annual plan codes (must match the backend). Leave blank to hide the
# monthly/annual toggle on /billing and bill everyone monthly.
VITE_PAYSTACK_THINKER_LITE_ANNUAL_PLAN_CODE=
VITE_PAYSTACK_DEEP_THINKER_ANNUAL_PLAN_CODE=
# Chrome extension ID(s) — enables the dashboard→extension session handoff.
# Find it at chrome://extensions (Developer mode). Comma-separate several:
# every install source has its own ID (Web Store, a build loaded unpacked),
# and the dashboard uses whichever one is installed. Blank disables handoff.
VITE_EXTENSION_ID=
