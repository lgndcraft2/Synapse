{
  "manifest_version": 3,
  "name": "Synapse",
  "version": "0.1.0",
  "description": "Rebuilds any page for your brain.",

  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],

  "host_permissions": [
    "https://api.usesynapse.cv/*",
    "http://localhost:8000/*",
    "http://*/*",
    "https://*/*",
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*",
      "http://localhost:3000/*",
      "https://usesynapse.cv/*",
      "https://*.usesynapse.cv/*"
    ]
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": [
        "purify.min.js",
        "lib/geometry.js",
        "content.js",
        "explain/host.js",
        "explain/core.js",
        "explain/context.js",
        "explain/panel.js",
        "explain/highlight.js",
        "explain/circle.js",
        "explain/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
